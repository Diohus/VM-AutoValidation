# LLM chỉ diễn giải, không quyết định ký. Điền khóa tại máy, không chia sẻ/commit .env.
OPENAI_API_KEY=
# Model có thể thay đổi theo quyền truy cập API của tài khoản.
OPENAI_MODEL=gpt-6-luna
# Endpoint OpenAI hoặc dịch vụ tương thích Responses API được phép sử dụng.
OPENAI_BASE_URL=https://api.openai.com/v1
# Đặt false để tắt LLM; khởi động lại server sau khi sửa cấu hình.
LLM_ENABLED=true
# Thời gian chờ tính bằng mili giây.
LLM_TIMEOUT_MS=30000
